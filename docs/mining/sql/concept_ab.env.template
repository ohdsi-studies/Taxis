# =============================================================================
# concept_ab.env.template — Configuration Template for CONCEPT_AB Mining Engine
# =============================================================================
# Instructions:
# 1. Copy this file to 'concept_ab.env' in your working directory.
# 2. Fill in database connection and schema parameters appropriate for your CDM.
# 3. Ensure the project lookup tables (cab_visit_hierarchy, cab_procedure, etc.) are loaded into PROJECT_REFERENCE_SCHEMA (via Taxis::loadReferenceTables).
# =============================================================================

# -------- Project Root & Java Configuration -----------------------------------
# Path to the directory containing concept_ab_run.R, concept_ab.env, and the SQL scripts
CAB_HOME=.
# Path to 64-bit Java Runtime Environment (Java 17 recommended for DatabaseConnector)
JAVA_HOME=
# Directory holding your database JDBC driver (e.g., PostgreSQL, Redshift, Snowflake JARs)
DATABASECONNECTOR_JAR_FOLDER=./drivers

# ================== DATABASE CONNECTION (OHDSI Standard) =======================
# Target DBMS dialect: "postgresql" | "sql server" | "redshift" | "snowflake" | "oracle" | "bigquery"
DBMS=postgresql

# Database server specification in DatabaseConnector format (e.g., "localhost/cdm" or "server.institution.org/db")
DB_SERVER=localhost/cdm
DB_PORT=5432
DB_USER=cdm_user
DB_PASSWORD=
# Authentication mode: "prompt" (recommended: interactive password entry) | "password_env" | "integrated"
CAB_AUTH_MODE=prompt
# Additional JDBC connection parameters (e.g. "ssl=true") or leave blank
DB_EXTRA_SETTINGS=

# ================== CDM & WORK SCHEMAS =========================================
# Read-only schema containing the OMOP CDM v5.4 tables (person, visit_occurrence, condition_occurrence, etc.)
CDM_SCHEMA=cdm

# Read-only schema containing the pre-loaded TAXIS vocabulary lookup tables (cab_visit_hierarchy, cab_procedure, etc.)
PROJECT_REFERENCE_SCHEMA=taxis_lookups

# Read-only schema containing the OMOP vocabulary tables (concept, concept_ancestor, concept_relationship)
OMOP_REFERENCE_SCHEMA=vocabulary

# Writable results schema where the pipeline creates cumulative and final output tables
RESULTS_SCHEMA=taxis_results

# -------- SQL Script Locations ------------------------------------------------
CAB_SQL_DIR=.
CAB_SQL_INIT=concept_ab_init.sql
CAB_SQL_BATCH=concept_ab_batch.sql
CAB_SQL_FINALIZE=concept_ab_finalize.sql

# -------- Runtime Partitioning Controls ---------------------------------------
# Total number of random batches to partition the patient population into (default: 40)
# Timing benchmarks: 20-40 batches provide balanced memory footprint and parallel stability.
CAB_BATCH_COUNT=40

# Number of batches to execute in the current invocation (set to 40 for a full run, or 1 for dry-run)
CAB_PARTIAL_RUN_BATCH_LIMIT=40

# Descriptive data profiling batch limit: number of batches to run descriptive characterization for (default: 2)
CAB_DATA_PROFILE_BATCH_LIMIT=2

# -------- Debugging & Rerun Controls -----------------------------------------
# Set to 'true' to output rendered and translated SQL queries to disk for inspection
CAB_DEBUG=false

# Set to 'true' to skip init and batch loops and run only finalize against existing cumulative tables
CAB_FINALIZE_ONLY=false

# Caps which batches finalize rolls up (leave empty for all completed batches)
CAB_MAX_BATCH_NUMBER=

# Automatically drops intermediate cumulative working tables after finalization to conserve disk space
CAB_DROP_CUM_TABLES=true

# Emit CREATE INDEX and UPDATE STATISTICS DDL statements (default: true).
# Set to 'false' for cloud columnar architectures (e.g. Snowflake, BigQuery) where secondary indexes are unsupported.
CAB_CREATE_INDEX_DDL=true

