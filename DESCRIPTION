Package: Taxis
Title: Temporal Association eXploration for Clinical Inference Studies (TAXIS) Concept AB Mining Engine
Version: 1.0.0
Authors@R: c(
    person("Stephen", "Bandeian", email = "sbandeian@gmail.com", role = c("aut", "cph"), comment = c(role = "Original SQL & Analytic Code Author, Principal Investigator")),
    person("J. Marc", "Overhage", email = "overhage@gmail.com", role = "aut", comment = c(role = "Co-Principal Investigator")),
    person("Gowtham", "Rao", email = "gowtham.rao@coreason.ai", role = c("aut", "cre"), comment = c(role = "Study Package Architect & Maintainer")),
